{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Data.Pages }}
    {{- /* Keep the sitemap and the robots meta tag telling Google the same
           thing: skip anything marked noindex, and thin tag pages. */ -}}
    {{- $thinTerm := and (eq .Kind "term") (lt (len .Pages) 3) -}}
    {{- if and (not .Params.noindex) (not $thinTerm) (ne .Kind "404") }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
    {{- end }}
  </url>
    {{- end }}
  {{- end }}
</urlset>
